# freebuff2api environment variables (all optional; config.json also supported)

# Freebuff account tokens — comma or newline separated. Format: token or token:uid
FREEBUFF_TOKEN=

# API key protecting the OpenAI/Anthropic endpoints (default: freebuff-default-key)
FREEBUFF_API_KEY=freebuff-default-key

# Outbound proxies for rotating pools — comma or newline separated.
# Supported: http:// https:// socks4a:// socks5:// socks5h://  (auth in URL)
PROXIES=

# Enable debug logging
#FREEBUFF_DEBUG=true

# Proxy-only mode: never fall back to a direct connection when proxies fail,
# so the VPS egress IP is never exposed upstream (avoids ip_capped / IP linking
# across accounts). Set to "true" when sharing a pool across many accounts.
#FREEBUFF_NO_DIRECT=true

# TLS stealth: impersonate a real browser's TLS/HTTP2 fingerprint (JA3/JA4) on
# every upstream request instead of Node/undici's OpenSSL-shaped ClientHello.
# Requires libcurl-impersonate (auto-downloaded on Windows; set LIBCURL_PATH on
# other platforms). Fatal load errors fall back to the plain fetch path.
#TLS_STEALTH=true
#TLS_PROFILE=chrome          # chrome | chrome136 | safari2601 | firefox147 | edge101 | ...
#FREEBUFF_ACCT_RPM=60            # per-account max chat requests/minute
#FREEBUFF_GLOBAL_RPM=300         # global max chat requests/minute
#FREEBUFF_AFFINITY_MAX_USES=3    # max consecutive reuse of one account+model session
#FREEBUFF_COOLDOWN_BASE_MS=30000 # stepped backoff base
#FREEBUFF_COOLDOWN_CAP_MS=1800000 # stepped backoff cap

# Listen address (default 0.0.0.0:8787)
HOST=0.0.0.0
PORT=8787
